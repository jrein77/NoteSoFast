# Copy this file to .env and fill in your own key to run with the live Anthropic API.
# Without a key, the app starts in Demo mode (mock LLM placeholder responses)
# so the chat / questions / hints still produce something usable for the demo.
#
# Toggle live vs. demo at runtime by clicking the pill at the bottom of the
# sidebar (or by hitting POST /api/mock-mode with {"mock": false|true}).
#
# Optional: force a mode regardless of saved state by setting MOCK_MODE.
#   MOCK_MODE=1   # always mock
#   MOCK_MODE=0   # always live (requires ANTHROPIC_API_KEY)

ANTHROPIC_API_KEY=
# MOCK_MODE=
